### Yoshinari Nomura <nom@csce.kyushu-u.ac.jp>
### $Id: Makefile.2,v 1.2 2001/12/19 06:00:09 nom Exp $
################################################################

PROGRAM		= test2

# mon.o must be first so that ld places mon.o $400.

OBJECTS		= crt0.o mon.o csys68k.o inchrw.o mtk_asm.o \
			mtk_c.o outchr.o test2.o

SRCS		= crt0.s mon.s csys68k.c inchrw.s mtk_asm.s \
			mtk_c.c outchr.s test2.c

ASMGLIS		= crt0.glis mon.glis csys68k.glis inchrw.glis mtk_asm.glis \
			mtk_c.glis outchr.glis test2.glis

include $(LIB_JIKKEN)/make.conf

# リファレンスモニタ: mon.o は dist/ の tgz から取り出す（一番上には mon.s を置かない）。
mon.o: dist/mon_r2_230k+sc5v2.tgz
	tar xzf $< -O mon_r2_230k+sc5v2.o > $@

# test2.LIS の材料。mon.s がないので mon.glis ができない → 空のファイルで代用する。
mon.glis:
	touch $@
